---
import Base from "../layouts/Base.astro";
import Hero from "../components/home/Hero.astro";
import StatStrip from "../components/home/StatStrip.astro";
import CategoryGrid from "../components/home/CategoryGrid.astro";
import KnowHow from "../components/KnowHow.astro";
import WishPool from "../components/WishPool.astro";
import SurveyPopup from "../components/SurveyPopup.astro";
import EventPopup from "../components/EventPopup.astro";
import { stats } from "../lib/projects";

const description = `台灣公民科技專案的目錄。${stats.listed} 個專案依議題分類，每一個都有自己的頁面，可以直接把連結傳給想拉進來的人。`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "台灣公民科技資料庫",
  alternateName: "Civic Tech Taiwan",
  url: "https://civictech.tw",
  inLanguage: "zh-Hant-TW",
  description,
  publisher: {
    "@type": "Organization",
    name: "g0v jothon 揪松團",
    url: "https://jothon.g0v.tw/about/",
  },
};
---

<Base title="台灣公民科技資料庫 Civic Tech Taiwan" description={description} jsonLd={jsonLd}>
  <Hero />
  <StatStrip />
  <CategoryGrid />
  <KnowHow />
  <WishPool />
  <SurveyPopup />
  <EventPopup />
</Base>
