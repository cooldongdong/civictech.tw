---
import HeroVideo from '../components/HeroVideo.astro';
import ProjectList from '../components/ProjectList.astro';
import KnowHow from '../components/KnowHow.astro';
import WishPool from '../components/WishPool.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import SurveyPopup from '../components/SurveyPopup.astro';
import knowHowData from '../content/knowhow/data.json';
import '../styles/global.css';

const totalCount = knowHowData.length;
---

<html lang="zh-Hant-TW">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>台灣公民科技資料庫 Civic Tech Taiwan</title>
		<meta name="description" content={`匯聚 ${totalCount} 則關鍵 Know-how 與公民科技專案的入口平台`} />
	</head>
	<body>
		<Navbar />
		<HeroVideo />
		<ProjectList />
		<KnowHow />
		<WishPool />
		<Footer />
		<SurveyPopup />
	</body>
</html>