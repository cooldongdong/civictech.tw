---
import Base from "../layouts/Base.astro";
import { categories } from "../data/categories";
---

<Base title="找不到這一頁｜台灣公民科技資料庫" description="這個網址不存在，或是它換過位置。">
  <section class="wrap flex min-h-[70vh] flex-col justify-center py-24">
    <p class="num m-0 text-[3rem]" style="color:var(--ink-muted)">404</p>
    <h1 class="m-0 mt-3 text-[1.8rem] font-semibold" style="color:var(--ink)">這個網址找不到東西</h1>
    <p class="mt-3 max-w-[48ch] text-[0.98rem]" style="color:var(--ink-muted)">
      可能是專案改名了，或是這個連結是舊版網站留下來的。從議題重新找找看：
    </p>
    <ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
      {categories.map((c) => (
        <li>
          <a
            href={`/c/${c.slug}`}
            class="inline-block rounded-lg border px-3.5 py-2 text-sm no-underline"
            style={`border-color:var(--line);background:var(--surface);color:var(--c-${c.slug})`}
          >
            {c.name}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
