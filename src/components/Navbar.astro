---
// src/components/Navbar.astro
---

<nav class="navbar">
  <div class="navbar-container">
    <a href="#hero" class="logo"> 台灣公民科技資料庫 </a>
    <ul class="nav-links">
      <li><a href="#project-list" class="nav-link">專案清單</a></li>
      <li><a href="#know-how" class="nav-link">行動指引</a></li>
      <li><a href="#wish-pool" class="nav-link">專案許願池</a></li>
      <li><a href="#footer" class="nav-link">協作與聯繫</a></li>
    </ul>
  </div>
</nav>

<style is:global>
  /* 啟用全網頁平滑滾動 */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 80px; /* 防止固定導覽列遮擋標題 */
  }
</style>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: transparent;
    border-bottom: 1px solid transparent;
    box-sizing: border-box;
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: padding 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.3s ease;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    transition: color 0.3s ease;
    position: relative;
    padding: 4px 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }

  .nav-link:hover,
  .nav-link.active {
    color: #ffffff;
    text-shadow: none;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #38bdf8;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* 滾動後的樣式 (Scrolled State) */
  .navbar.scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
  }

  .navbar.scrolled .navbar-container {
    padding: 16px 20px;
  }

  .navbar.scrolled .logo {
    color: #0f172a;
    text-shadow: none;
  }

  .navbar.scrolled .nav-link {
    color: #475569;
    text-shadow: none;
  }

  .navbar.scrolled .nav-link:hover,
  .navbar.scrolled .nav-link.active {
    color: #0284c7;
  }

  .navbar.scrolled .nav-link::after {
    background-color: #0284c7;
  }

  /* 響應式調整 */
  @media (max-width: 640px) {
    .navbar-container {
      padding: 16px 16px;
    }

    .logo {
      font-size: 1.05rem;
    }

    .nav-links {
      gap: 16px;
    }

    .nav-link {
      font-size: 0.9rem;
    }

    .navbar.scrolled .navbar-container {
      padding: 12px 16px;
    }
  }
</style>

<script>
  // 處理滾動背景變色
  const navbar = document.querySelector(".navbar");
  const handleScroll = () => {
    if (window.scrollY > 50) {
      navbar?.classList.add("scrolled");
    } else {
      navbar?.classList.remove("scrolled");
    }
  };
  window.addEventListener("scroll", handleScroll, { passive: true });
  // 頁面重新整理時初始化一次
  handleScroll();

  // 處理滾動時自動高亮對應的 nav-link (Intersection Observer)
  const sections = document.querySelectorAll("section[id], footer[id]");
  const navLinks = document.querySelectorAll(".nav-link");

  const observerOptions = {
    root: null,
    rootMargin: "-30% 0px -70% 0px", // 聚焦在螢幕中上區塊時觸發
    threshold: 0,
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute("id");
        navLinks.forEach((link) => {
          const href = link.getAttribute("href");
          if (href === `#${id}`) {
            link.classList.add("active");
          } else {
            link.classList.remove("active");
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach((section) => observer.observe(section));
</script>
