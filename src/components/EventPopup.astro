---
// src/components/EventPopup.astro — 角落滑入式活動報名邀請，可關閉。
// 在問卷卡之後才滑出，像「新訊息」進來，並把問卷卡往上擠。
//
// EXPIRES_AT 是 2026-09-19 補的。這張卡 6/29 上線、辦完之後沒有人回來關它，
// 到 9/15 盤點時已經對每一個進站的人跳了將近三個月。
// 旁邊那張 SurveyPopup 從第一天就有自動降級的邏輯，這張漏了——
// 教訓是限時元件的過期條件要跟元件一起寫，補做的那一次通常不會發生。
//
// 活動結束後改這一行就好；日期是台灣時間的當天結束。
const EXPIRES_AT = "2026-06-30";
const expired = Date.now() > new Date(`${EXPIRES_AT}T23:59:59+08:00`).getTime();
---

{!expired && (

<div
  id="event-popup"
  class="fixed bottom-5 right-5 z-[51] w-[calc(100%-2.5rem)] sm:w-[336px] translate-y-6 opacity-0 pointer-events-none transition-all duration-500 ease-out"
>
  <div
    class="relative bg-white border border-slate-200 rounded-2xl shadow-xl shadow-slate-900/10 p-4"
  >
    <button
      id="event-popup-close"
      type="button"
      aria-label="關閉"
      class="absolute top-3 right-3 w-7 h-7 flex items-center justify-center rounded-full text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <span class="mb-3 inline-block rounded-full px-2.5 py-1 text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">
      活動報名
    </span>
    <h3 class="text-base font-bold text-slate-900 mb-1.5 pr-6 leading-snug">
      公民科技跑咖松
    </h3>
    <p class="text-[0.8rem] text-slate-500 leading-relaxed mb-4">
      想認識更多公民科技夥伴？快來報名跑咖松，一起聊聊手上的坑與點子！
    </p>

    <a
      href="https://docs.google.com/forms/d/e/1FAIpQLScZdQBVh4eKCCi5x8uM4Pypv-RHcDlXAO6eDGjGUS7P0H5IOg/viewform"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-full items-center justify-center gap-1.5 bg-gradient-to-br from-primary-600 to-primary-700 text-white py-2.5 px-4 text-xs font-semibold rounded-lg shadow-sm shadow-primary-600/20 hover:from-primary-700 hover:to-primary-800 hover:-translate-y-0.5 transition-all duration-300 no-underline"
    >
      立即報名
    </a>
  </div>
</div>
)}

<script>
  const popup = document.getElementById("event-popup");
  const closeBtn = document.getElementById("event-popup-close");
  const survey = document.getElementById("survey-popup");
  const DISMISS_KEY = "event-popup-dismissed";
  const hiddenClasses = ["translate-y-6", "opacity-0", "pointer-events-none"];

  const BASE = 20; // 角落間距 bottom-5 = 1.25rem
  const GAP = 12; // 兩張卡之間的間距

  // 把問卷卡往上推，讓出本卡的高度，營造「新訊息把舊的擠上去」的效果
  const pushSurvey = () => {
    if (popup && survey)
      survey.style.bottom = BASE + popup.offsetHeight + GAP + "px";
  };
  const resetSurvey = () => {
    if (survey) survey.style.bottom = "";
  };

  if (popup && !sessionStorage.getItem(DISMISS_KEY)) {
    // 問卷卡 800ms 先出現，這張較晚滑出，像新訊息進來並把問卷卡往上擠
    window.setTimeout(() => {
      popup.classList.remove(...hiddenClasses);
      pushSurvey();
    }, 1800);

    closeBtn?.addEventListener("click", () => {
      popup.classList.add(...hiddenClasses);
      resetSurvey(); // 關閉後讓問卷卡滑回角落
      sessionStorage.setItem(DISMISS_KEY, "1"); // 本次瀏覽不再出現
    });
  }
</script>
