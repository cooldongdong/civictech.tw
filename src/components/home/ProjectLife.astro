---
// 一個專案的一生：用一個真的專案示範「一個點子怎麼變成大家天天在用的東西」。
// 挑萌典，是因為它在大松紀錄裡出現最多次（從 2013 年回來報告到 2020 年），每一步都有資料可以佐證。
// 每一步都從資料裡來（大松紀錄、連結欄、Slack 頻道、AI insight），缺哪一步就不寫，不替它編故事。
import { projectLife } from "../../lib/homeviz";

const life = projectLife("萌典");
---

{life && life.steps.length >= 3 && (
  <section id="project-life" class="home-section">
    <div class="wrap">
      <div class="home-head">
        <h2 class="home-title">一個點子，怎麼變成大家天天在用的東西</h2>
        <p class="home-lede">
          以<a href={`/p/${life.project.slug}`} style="color:var(--accent)">{life.project.name}</a>為例。
          它不是一次做完的：有人在黑客松上提出來，接著一群人一棒一棒地接下去。
        </p>
      </div>

      <ol class="life" style={`--n:${life.steps.length}`}>
        {life.steps.map((s, i) => (
          <li class="life-step" style={`--k:${i}`}>
            <span class="life-dot" aria-hidden="true"></span>
            {s.when && <p class="life-when num">{s.when}</p>}
            <h3 class="life-title">{s.title}</h3>
            <p class="life-body">{s.body}</p>
            {s.href && (
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="life-link">去看看 →</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .life {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }
  /* 底線與跟著捲動填滿的進度線 */
  .life::before,
  .life::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    border-radius: 2px;
    background: var(--line);
  }
  .life::after { background: var(--accent); transform-origin: top; transform: scaleY(1); }

  @media (min-width: 900px) {
    .life {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      gap: 1.5rem;
      padding: 2.25rem 0 0;
    }
    .life::before,
    .life::after { left: 0; right: 0; top: 0.45rem; bottom: auto; width: auto; height: 2px; }
    .life::after { transform-origin: left; transform: scaleX(1); }
  }

  .life-step { position: relative; }
  .life-dot {
    position: absolute;
    left: -1.75rem;
    top: 0.15rem;
    width: 0.8rem;
    height: 0.8rem;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--paper);
  }
  @media (min-width: 900px) { .life-dot { left: 0; top: -2.25rem; } }

  .life-when { margin: 0 0 0.35rem; font-size: 0.78rem; color: var(--accent); }
  .life-title { margin: 0 0 0.45rem; font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .life-body { margin: 0; font-size: 0.88rem; line-height: 1.75; color: var(--ink-muted); }
  .life-link { display: inline-block; margin-top: 0.6rem; font-size: 0.85rem; color: var(--accent); }

  /* 進度線與每一步，跟著捲動位置依序出現 */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .life { view-timeline-name: --life; }
      .life::after {
        animation: life-fill-y linear both;
        animation-timeline: --life;
        animation-range: entry 40% cover 60%;
      }
      .life-step {
        animation: life-step linear both;
        animation-timeline: --life;
        animation-range: entry calc(40% + var(--k) * 6%) cover calc(30% + var(--k) * 6%);
      }
      @media (min-width: 900px) {
        .life::after { animation-name: life-fill-x; }
      }
    }
  }
  @keyframes life-fill-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes life-fill-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes life-step { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
</style>
