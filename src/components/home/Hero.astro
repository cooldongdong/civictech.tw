---
import FeaturedProject from "./FeaturedProject.astro";

const ytId = "kitNCWX-aHY";
const modalSrc = `https://www.youtube.com/embed/${ytId}?autoplay=1&controls=1&rel=0&modestbranding=1&playsinline=1`;
---

<section id="hero" class="relative isolate overflow-hidden" data-hero>
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="wrap relative z-10 grid items-center gap-10 pb-16 pt-28 sm:pb-20 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16 lg:pb-24 lg:pt-32">
    <div>
      <h1 class="text-[2.1rem] font-semibold leading-[1.15] text-white sm:text-5xl lg:text-[3.4rem]">
        想改變的事，<br class="hidden sm:block" />已經有人在做
      </h1>
      <p class="mt-5 max-w-[34ch] text-[0.98rem] leading-relaxed text-white/70 sm:text-lg">
        台灣公民科技專案的目錄。照你關心的議題分，挑一個，去用它，或去找做它的人。
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#categories"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-5 py-3 text-[0.95rem] font-medium text-[#14130f] no-underline transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.98]"
        >
          挑一個你關心的事
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="12" y1="5" x2="12" y2="19" /><polyline points="19 12 12 19 5 12" />
          </svg>
        </a>
        <button
          type="button"
          id="hero-video-btn"
          class="inline-flex items-center gap-2 rounded-lg border border-white/25 bg-white/5 px-5 py-3 text-[0.95rem] text-white/90 transition-colors duration-200 hover:bg-white/12"
        >
          <svg width="13" height="13" viewBox="0 0 10 12" fill="currentColor" aria-hidden="true"><polygon points="0,0 10,6 0,12" /></svg>
          看社群長什麼樣子
        </button>
      </div>
    </div>

    <FeaturedProject />
  </div>
</section>

<div id="video-modal" class="video-modal" data-src={modalSrc} role="dialog" aria-modal="true" aria-hidden="true" aria-label="g0v 黑客松紀錄片">
  <div id="modal-backdrop" class="modal-backdrop"></div>
  <div class="modal-dialog">
    <button id="modal-close" class="modal-close" aria-label="關閉影片">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
    <div class="modal-video-wrap">
      <iframe id="modal-iframe" src="" title="g0v 黑客松紀錄片" allow="autoplay; encrypted-media; fullscreen" allowfullscreen></iframe>
    </div>
    <p class="modal-footer">
      <span>g0v contributor Sam 與 Taiwan Plus 團隊拍攝的 g0v 大松紀錄。</span>
      <a href={`https://youtu.be/${ytId}`} target="_blank" rel="noopener noreferrer">YouTube</a>
    </p>
  </div>
</div>

<style>
  [data-hero] {
    background: #12110d;
  }
  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  /* 粒子場上方壓一層暖色暈，讓白字在任何粒子密度下都讀得到 */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(120% 80% at 18% 30%, rgba(31, 90, 75, 0.35) 0%, transparent 60%),
      linear-gradient(180deg, rgba(18, 17, 13, 0.7) 0%, rgba(18, 17, 13, 0.25) 45%, rgba(18, 17, 13, 0.85) 100%);
  }

  .video-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .video-modal.open { opacity: 1; pointer-events: auto; }
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(10, 9, 7, 0.82);
    backdrop-filter: blur(6px);
  }
  .modal-dialog { position: relative; width: min(92vw, 900px); z-index: 1; }
  .modal-close {
    position: absolute; top: -2.6rem; right: 0;
    background: transparent; border: none; color: rgba(255,255,255,0.6);
    cursor: pointer; padding: 4px; display: flex;
  }
  .modal-close:hover { color: #fff; }
  .modal-video-wrap {
    position: relative; padding-bottom: 56.25%; height: 0;
    border-radius: 10px; overflow: hidden;
  }
  .modal-video-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .modal-footer {
    margin-top: 0.7rem; display: flex; justify-content: space-between; gap: 1rem;
    font-size: 0.72rem; color: rgba(255,255,255,0.4);
  }
  .modal-footer a { color: rgba(255,255,255,0.6); }
</style>

<script>
  // ── 粒子場 ──
  // 沿用 2026-06 那版的 additive blending 星雲寫法（它是這個站最好的東西之一），
  // 改的是三件：色相從天藍轉為苔綠、不在視窗外燒 CPU、reduced-motion 時只畫一張靜態。
  const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
  const hero = document.querySelector("[data-hero]") as HTMLElement | null;

  if (canvas && hero) {
    const ctx = canvas.getContext("2d")!;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
    let mouseX = -9999, mouseY = -9999, mouseIn = false;
    let running = false, rafId = 0, last = 0;

    function resize() {
      W = hero!.offsetWidth;
      H = hero!.offsetHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      canvas!.style.width = `${W}px`;
      canvas!.style.height = `${H}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    resize();
    new ResizeObserver(resize).observe(hero);

    const COUNT = window.innerWidth < 768 ? 45 : 80;
    const pts = Array.from({ length: COUNT }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      vx: (Math.random() - 0.5) * 0.28,
      vy: (Math.random() - 0.5) * 0.28,
      r: Math.random() * 1.3 + 0.5,
      a: Math.random() * 0.45 + 0.25,
      h: 142 + Math.random() * 38,
      f1: 0.3 + Math.random() * 0.5,
      f2: 0.3 + Math.random() * 0.5,
      p1: Math.random() * Math.PI * 2,
      p2: Math.random() * Math.PI * 2,
      wAmp: 0.004 + Math.random() * 0.007,
    }));

    function draw(t: number) {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";
      for (const p of pts) {
        const near = mouseIn && Math.hypot(mouseX - p.x, mouseY - p.y) < 110;
        ctx.beginPath();
        ctx.arc(p.x, p.y, (near ? p.r * 2 : p.r) * 4.5, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${p.h},55%,58%,0.04)`;
        ctx.fill();
      }
      ctx.globalCompositeOperation = "source-over";
      for (const p of pts) {
        const near = mouseIn && Math.hypot(mouseX - p.x, mouseY - p.y) < 110;
        ctx.beginPath();
        ctx.arc(p.x, p.y, near ? p.r * 2 : p.r, 0, Math.PI * 2);
        ctx.fillStyle = `hsla(${p.h},60%,${near ? 86 : 72}%,${near ? Math.min(p.a * 2, 0.9) : p.a})`;
        ctx.fill();
      }
    }

    function step(now: number) {
      const t = now / 1000;
      for (const p of pts) {
        p.vx += Math.sin(t * p.f1 + p.p1) * p.wAmp;
        p.vy += Math.cos(t * p.f2 + p.p2) * p.wAmp;
        if (mouseIn) {
          const dx = mouseX - p.x, dy = mouseY - p.y;
          const d = Math.hypot(dx, dy);
          if (d < 200 && d > 0) {
            const f = ((200 - d) / 200) * 0.02;
            p.vx += dx * f; p.vy += dy * f;
          }
        }
        p.vx *= 0.97; p.vy *= 0.97;
        p.x = (p.x + p.vx + W) % W;
        p.y = (p.y + p.vy + H) % H;
      }
      draw(now);
      last = now;
      rafId = requestAnimationFrame(step);
    }

    if (reduced) {
      draw(0);
    } else {
      // 只在 hero 還看得到時跑，捲走就停——省電，也避免背景分頁空轉
      const vis = new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !running) {
          running = true;
          rafId = requestAnimationFrame(step);
        } else if (!e.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      }, { threshold: 0 });
      vis.observe(hero);

      hero.addEventListener("pointermove", (e) => {
        const r = canvas.getBoundingClientRect();
        mouseX = e.clientX - r.left;
        mouseY = e.clientY - r.top;
        mouseIn = true;
      }, { passive: true });
      hero.addEventListener("pointerleave", () => { mouseIn = false; });
    }
  }

  // ── 影片 ──
  // 舊版是「點 hero 背景任何一處就跳出 YouTube」，那是個陷阱：
  // 使用者只是想點空白處，卻被丟進一支影片。改成只有明確的按鈕會開。
  const modal = document.getElementById("video-modal");
  const iframe = document.getElementById("modal-iframe") as HTMLIFrameElement | null;
  const src = modal?.dataset.src ?? "";
  let lastFocus: HTMLElement | null = null;

  function open() {
    if (!modal || !iframe) return;
    lastFocus = document.activeElement as HTMLElement;
    iframe.src = src;
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    (document.getElementById("modal-close") as HTMLElement)?.focus();
  }
  function close() {
    if (!modal || !iframe) return;
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    iframe.src = "";
    document.body.style.overflow = "";
    lastFocus?.focus();
  }
  document.getElementById("hero-video-btn")?.addEventListener("click", open);
  document.getElementById("modal-close")?.addEventListener("click", close);
  document.getElementById("modal-backdrop")?.addEventListener("click", close);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal?.classList.contains("open")) close();
  });
</script>
