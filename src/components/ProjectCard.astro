---
import type { Project } from "../lib/projects";
import { categoryBySlug } from "../data/categories";

interface Props {
  project: Project;
  index?: number;
  showCategory?: boolean;
}
const { project, index = 0, showCategory = false } = Astro.props;
const category = categoryBySlug.get(project.category)!;
---

<a href={`/p/${project.slug}`} class="card rise" style={`--i:${Math.min(index, 8)};--tint:var(--c-${project.category})`}>
  {showCategory && <span class="card-cat">{category.name}</span>}
  <h3 class="card-name">
    {project.name}
    {project.nameEn && <span class="card-name-en">{project.nameEn}</span>}
  </h3>

  {project.intro ? (
    <p class="card-intro">{project.intro.length > 84 ? project.intro.slice(0, 84) + "⋯" : project.intro}</p>
  ) : (
    <p class="card-gap">還沒有人寫介紹</p>
  )}

  <div class="card-foot">
    {project.links.length > 0 ? (
      <span class="card-links">{project.links.map((l) => l.label).join("・")}</span>
    ) : (
      <span class="card-links card-gap">沒有可用的連結</span>
    )}
    <span class="card-go" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem 1.2rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s var(--ease-out-expo);
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--tint) 50%, var(--line));
    transform: translateY(-2px);
  }
  .card-cat {
    font-size: 0.72rem;
    color: var(--tint);
  }
  .card-name {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.45;
  }
  .card-name-en {
    display: block;
    font-size: 0.74rem;
    font-weight: 400;
    color: var(--ink-muted);
    margin-top: 0.15rem;
  }
  .card-intro {
    margin: 0;
    flex: 1;
    font-size: 0.86rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .card-gap {
    margin: 0;
    flex: 1;
    font-size: 0.86rem;
    color: color-mix(in srgb, var(--ink-muted) 70%, transparent);
    font-style: italic;
  }
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.3rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }
  .card-links {
    font-size: 0.74rem;
    color: var(--ink-muted);
  }
  .card-go {
    color: var(--tint);
    transition: transform 0.2s ease;
  }
  .card:hover .card-go { transform: translateX(3px); }
</style>
