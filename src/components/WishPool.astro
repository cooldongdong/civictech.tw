---
// WishPool — 許願池。送出走 /api/wish（functions/api/wish.ts）代開 GitHub issue，送的人不用有 GitHub 帳號。
// 下方的卡片讀貼了 wish-approved 標籤的 issue；同一個標籤也是 Slack 頻道訂閱的過濾條件，貼上就會進頻道討論。
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section id="wish-pool" class="py-16 sm:py-20 lg:py-24">
  <div class="wrap max-w-4xl">
    <div class="mb-10">
      <h2 class="m-0 max-w-[20ch] text-[1.7rem] font-semibold sm:text-[2.1rem]" style="color:var(--ink)">
        想做但還沒有人做的事
      </h2>
      <p class="mb-0 mt-3 max-w-[48ch] text-[0.95rem] leading-relaxed" style="color:var(--ink-muted)">
        寫下來，社群裡就有人看得到。送出後會先經過人工審核才會出現在下面。
      </p>
    </div>

    <!-- Form -->
    <div class="mb-14 rounded-xl border p-6 sm:p-8" style="border-color:var(--line);background:var(--surface)">
      <form id="js-wish-form" class="space-y-5">
        <div>
          <label for="wish-q1" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">1</span>
            給專案取個酷名字：如「真的假的」、「阿美語萌典」，好記又有個性。
          </label>
          <input type="text" id="wish-q1" name="title" maxlength="80" required placeholder="請輸入專案名稱..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q2" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">2</span>
            一句話形容這個專案：透過 [技術] 解決 [誰] 的 [什麼痛點]。
          </label>
          <input type="text" id="wish-q2" name="description" maxlength="200" required placeholder="請輸入一句話形容..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q3" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">3</span>
            現有工具的不足：為什麼現在的方法行不通？
          </label>
          <textarea id="wish-q3" name="painPoint" maxlength="2000" rows="3" required placeholder="請描述目前的困境與不足..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)"></textarea>
        </div>

        <div>
          <label for="wish-q4" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">4</span>
            需要的超能力：（例如：徵求會用 ______ 的人）。
          </label>
          <input type="text" id="wish-q4" name="superpower" maxlength="300" required placeholder="例如：徵求會寫 React / 需要 UI 設計師..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q5" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">5</span>
            目前的進度：
          </label>
          <select id="wish-q5" name="progress" required
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)">
            <option value="" disabled selected>-- 請選擇目前進度 --</option>
            <option value="已有構想">已有構想</option>
            <option value="已有草稿">已有草稿</option>
            <option value="已有資料">已有資料</option>
          </select>
        </div>

        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-language="zh-tw"></div>

        <p class="m-0 text-xs leading-relaxed" style="color:var(--ink-muted)">
          送出後會在 GitHub 上公開成一張提案頁，請不要填聯絡方式或其他個人資料。
        </p>

        <button type="submit" id="js-wish-submit"
          class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg border-none py-3 text-sm font-medium transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.99]" style="background:var(--accent-fill);color:var(--on-accent)">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
          送出許願
        </button>
      </form>

      <div id="js-success-msg" class="mt-5 hidden rounded-lg border-l-2 px-4 py-3 text-sm" style="border-color:var(--accent);background:var(--accent-soft);color:var(--accent-ink)">
        已送出。為了擋掉灌水，會先經過人工審核，通過後才會出現在下方、進到 Slack 頻道讓大家討論。
        <a id="js-success-link" class="hidden underline" target="_blank" rel="noopener noreferrer">看你的提案頁 →</a>
      </div>
      <div id="js-error-msg" class="mt-5 hidden rounded-lg border-l-2 px-4 py-3 text-sm" role="alert" style="border-color:var(--gap);background:var(--surface-2);color:var(--ink)"></div>
    </div>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <!-- Display area -->
    <div>
      <h3 class="m-0 mb-6 text-base font-semibold" style="color:var(--ink)">已經有人許過的願</h3>
      <div id="js-wishes-loading" class="grid grid-cols-1 gap-5 md:grid-cols-2" aria-hidden="true">
        <div class="h-[180px] animate-pulse rounded-xl" style="background:var(--surface-2)"></div>
        <div class="h-[180px] animate-pulse rounded-xl" style="background:var(--surface-2)"></div>
      </div>
      <div id="js-wishes-container" class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- JS rendered -->
      </div>
    </div>
  </div>
</section>

<style is:global>
  @reference "../styles/global.css";
  .flip-card {
    @apply bg-transparent cursor-pointer;
    height: 300px;
    perspective: 1000px;
  }
  .flip-card-inner {
    @apply relative w-full h-full text-center rounded-2xl;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }
  .flip-card:hover .flip-card-inner,
  .flip-card:focus .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-card-front, .flip-card-back {
    @apply absolute inset-0 rounded-2xl p-6 flex flex-col justify-between items-center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card-front {
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .flip-card-back {
    @apply items-start text-left;
    /* 背面用強調色淡底，翻過來一眼看得出是另一面，淺色深色都成立 */
    color: var(--ink);
    background: linear-gradient(140deg, var(--accent-soft) 0%, var(--surface-2) 100%);
    border: 1px solid var(--line);
    transform: rotateY(180deg);
  }
  .card-badge {
    @apply self-end px-3 py-1 rounded-full text-xs font-medium;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .avatar-placeholder {
    @apply w-14 h-14 rounded-full flex items-center justify-center text-2xl;
    background: linear-gradient(135deg, var(--accent-fill), var(--c-health));
  }
  .card-wish-title {
    @apply text-lg font-semibold my-2;
    color: var(--ink);
  }
  .card-wish-desc {
    @apply text-sm leading-relaxed text-center flex-1;
    color: var(--ink-muted);
  }
  .back-title {
    @apply text-base font-semibold mb-3 pb-2.5 w-full;
    color: var(--accent-ink);
    border-bottom: 1px solid var(--line-strong);
  }
  .back-content {
    @apply text-sm leading-relaxed flex-1;
  }
  .back-content p {
    @apply mb-2.5;
  }
  .back-content strong {
    color: var(--accent-ink);
  }
  .flip-hint {
    @apply text-xs;
    color: var(--ink-muted);
  }
  .back-links {
    @apply flex w-full justify-end gap-4 text-xs font-medium;
  }
  .back-links a {
    color: var(--accent-ink);
  }
</style>

<script>
  // 卡片從 GitHub 公開 API 讀，不帶 token：每個訪客自己的 IP 每小時 60 次，一次載入只用 1 次
  const REPO = import.meta.env.PUBLIC_SUGGEST_REPO || 'g0v/civictech-tw-data';
  const APPROVED_LABEL = 'wish-approved';
  const SLACK_URL = import.meta.env.PUBLIC_WISH_SLACK_URL;

  // 跟 functions/api/wish.ts 的 FIELDS 小標題一致，改名要兩邊一起改
  const HEADINGS: Record<string, string> = {
    '一句話形容': 'description',
    '現有工具的不足': 'painPoint',
    '需要的超能力': 'superpower',
    '目前的進度': 'progress',
  };

  const form = document.getElementById('js-wish-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('js-wish-submit') as HTMLButtonElement | null;
  const successMsg = document.getElementById('js-success-msg');
  const successLink = document.getElementById('js-success-link') as HTMLAnchorElement | null;
  const errorMsg = document.getElementById('js-error-msg');
  const container = document.getElementById('js-wishes-container');
  const loadingStatus = document.getElementById('js-wishes-loading');

  if (form && successMsg && errorMsg && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      // Turnstile 會在表單裡塞一個 cf-turnstile-response 欄位
      const turnstileToken = data['cf-turnstile-response'];
      delete data['cf-turnstile-response'];
      // 不要用 window.alert：它會擋住整個頁面，而且長得像瀏覽器出錯。
      // 錯誤訊息就寫在表單旁邊，使用者才知道自己填的東西還在。
      const showError = (message: string) => {
        errorMsg.textContent = message;
        errorMsg.classList.remove('hidden');
      };
      if (!turnstileToken) {
        showError('機器人驗證還沒跑完，等它打勾再送出。');
        return;
      }

      errorMsg.classList.add('hidden');
      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/wish', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, turnstileToken }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.message || '送不出去，稍後再按一次送出。');
        form.classList.add('hidden');
        if (successLink && out.url) {
          successLink.href = out.url;
          successLink.classList.remove('hidden');
        }
        successMsg.classList.remove('hidden');
      } catch (err) {
        console.error('送出失敗', err);
        const fallback = '送不出去，可能是網路的問題。你填的內容還在，稍後再按一次送出。';
        showError(err instanceof TypeError ? fallback : (err as Error).message || fallback);
        // Turnstile 的 token 只能用一次，失敗後要換一張新的
        (window as { turnstile?: { reset(): void } }).turnstile?.reset();
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  interface Issue { title: string; body: string | null; html_url: string; pull_request?: unknown }

  // issue 內文是 functions/api/wish.ts 組的：每個欄位一個 ### 小標題。
  // 審核的人在 GitHub 上改過內文也照樣拆得開，只要小標題沒動。
  function parseBody(body: string): Record<string, string> {
    const fields: Record<string, string> = {};
    const parts = body.split(/^### (.+)$/m);
    for (let i = 1; i < parts.length; i += 2) {
      const key = HEADINGS[parts[i].trim()];
      if (key) fields[key] = parts[i + 1].trim().replace(/^(\s*)\\#/gm, '$1#');
    }
    return fields;
  }

  async function loadWishes() {
    if (!container || !loadingStatus) return;
    try {
      const url = `https://api.github.com/repos/${REPO}/issues?labels=${encodeURIComponent(APPROVED_LABEL)}&state=open&per_page=100`;
      const response = await fetch(url, { headers: { Accept: 'application/vnd.github+json' } });
      if (!response.ok) throw new Error(`無法取得許願池資料（${response.status}）`);
      const issues = (await response.json()) as Issue[];

      const wishes = issues
        .filter((issue) => !issue.pull_request)
        .map((issue) => ({ title: issue.title, url: issue.html_url, ...parseBody(issue.body ?? '') }))
        .filter((wish) => wish.title);

      loadingStatus.classList.add('hidden');

      if (wishes.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-sm" style="color:var(--ink-muted)">目前尚無審核通過的許願專案，快來當第一個許願者吧！</div>`;
        return;
      }

      container.innerHTML = wishes.map(wish => `
        <div class="flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="card-badge">${escapeHTML(wish.progress ?? '')}</div>
              <div class="avatar-placeholder" aria-hidden="true"></div>
              <h4 class="card-wish-title">${escapeHTML(wish.title)}</h4>
              <p class="card-wish-desc">${escapeHTML(wish.description ?? '')}</p>
              <div class="flip-hint">翻面看它需要什麼</div>
            </div>
            <div class="flip-card-back">
              <h4 class="back-title">專案需求詳情</h4>
              <div class="back-content">
                <p><strong>現況痛點：</strong>${escapeHTML(wish.painPoint ?? '')}</p>
                <p><strong>極需支援：</strong>${escapeHTML(wish.superpower ?? '')}</p>
                <p><strong>目前進度：</strong>${escapeHTML(wish.progress ?? '')}</p>
              </div>
              <div class="back-links">
                ${SLACK_URL ? `<a href="${escapeHTML(SLACK_URL)}" target="_blank" rel="noopener noreferrer">到 Slack 一起聊 →</a>` : ''}
                <a href="${escapeHTML(wish.url)}" target="_blank" rel="noopener noreferrer">提案頁 →</a>
              </div>
            </div>
          </div>
        </div>
      `).join('');
    } catch (err) {
      console.error(err);
      loadingStatus.textContent = '載入許願池資料失敗，請重新整理網頁。';
    }
  }

  function escapeHTML(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  loadWishes();
</script>
