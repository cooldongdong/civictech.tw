---
// WishPool — 前端 JS 撈取 Google Sheet
---

<section id="wish-pool" class="relative py-20 sm:py-24 px-5 bg-slate-50">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent"></div>

  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block text-xs font-semibold text-primary-600 bg-primary-500/8 px-4 py-1.5 rounded-full mb-4 tracking-wide">
        💡 專案許願
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 mb-3">
        公民科技專案許願池
      </h2>
      <p class="text-base text-slate-500 max-w-md mx-auto leading-relaxed">
        有想法？填寫表單分享你的專案構想，與社群一起協作實現。
      </p>
    </div>

    <!-- Form -->
    <div class="bg-white border border-slate-200 rounded-2xl p-8 sm:p-10 mb-16 shadow-sm">
      <form id="js-wish-form" class="space-y-5">
        <div>
          <label for="wish-q1" class="flex items-start gap-2.5 text-sm font-medium text-slate-700 mb-2 leading-snug">
            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] text-[0.7rem] font-bold text-primary-600 bg-primary-500/10 rounded-full shrink-0 mt-0.5">1</span>
            給專案取個酷名字：如「真的假的」、「阿美語萌典」，好記又有個性。
          </label>
          <input type="text" id="wish-q1" name={import.meta.env.PUBLIC_ENTRY_TITLE} required placeholder="請輸入專案名稱..."
            class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-800 bg-slate-50 transition-all duration-150 focus:outline-none focus:border-primary-500 focus:ring-3 focus:ring-primary-500/10 focus:bg-white" />
        </div>

        <div>
          <label for="wish-q2" class="flex items-start gap-2.5 text-sm font-medium text-slate-700 mb-2 leading-snug">
            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] text-[0.7rem] font-bold text-primary-600 bg-primary-500/10 rounded-full shrink-0 mt-0.5">2</span>
            一句話形容這個專案：透過 [技術] 解決 [誰] 的 [什麼痛點]。
          </label>
          <input type="text" id="wish-q2" name={import.meta.env.PUBLIC_ENTRY_DESCRIPTION} required placeholder="請輸入一句話形容..."
            class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-800 bg-slate-50 transition-all duration-150 focus:outline-none focus:border-primary-500 focus:ring-3 focus:ring-primary-500/10 focus:bg-white" />
        </div>

        <div>
          <label for="wish-q3" class="flex items-start gap-2.5 text-sm font-medium text-slate-700 mb-2 leading-snug">
            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] text-[0.7rem] font-bold text-primary-600 bg-primary-500/10 rounded-full shrink-0 mt-0.5">3</span>
            現有工具的不足：為什麼現在的方法行不通？
          </label>
          <textarea id="wish-q3" name={import.meta.env.PUBLIC_ENTRY_PAINPOINT} rows="3" required placeholder="請描述目前的困境與不足..."
            class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-800 bg-slate-50 transition-all duration-150 focus:outline-none focus:border-primary-500 focus:ring-3 focus:ring-primary-500/10 focus:bg-white font-sans"></textarea>
        </div>

        <div>
          <label for="wish-q4" class="flex items-start gap-2.5 text-sm font-medium text-slate-700 mb-2 leading-snug">
            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] text-[0.7rem] font-bold text-primary-600 bg-primary-500/10 rounded-full shrink-0 mt-0.5">4</span>
            需要的超能力：（例如：徵求會用 ______ 的人）。
          </label>
          <input type="text" id="wish-q4" name={import.meta.env.PUBLIC_ENTRY_SUPERPOWER} required placeholder="例如：徵求會寫 React / 需要 UI 設計師..."
            class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-800 bg-slate-50 transition-all duration-150 focus:outline-none focus:border-primary-500 focus:ring-3 focus:ring-primary-500/10 focus:bg-white" />
        </div>

        <div>
          <label for="wish-q5" class="flex items-start gap-2.5 text-sm font-medium text-slate-700 mb-2 leading-snug">
            <span class="inline-flex items-center justify-center min-w-[22px] h-[22px] text-[0.7rem] font-bold text-primary-600 bg-primary-500/10 rounded-full shrink-0 mt-0.5">5</span>
            目前的進度：
          </label>
          <select id="wish-q5" name={import.meta.env.PUBLIC_ENTRY_PROGRESS} required
            class="w-full px-4 py-3 border border-slate-200 rounded-xl text-sm text-slate-800 bg-slate-50 transition-all duration-150 focus:outline-none focus:border-primary-500 focus:ring-3 focus:ring-primary-500/10 focus:bg-white">
            <option value="" disabled selected>-- 請選擇目前進度 --</option>
            <option value="已有構想">已有構想</option>
            <option value="已有草稿">已有草稿</option>
            <option value="已有資料">已有資料</option>
          </select>
        </div>

        <button type="submit"
          class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-br from-primary-600 to-primary-700 text-white border-none py-3.5 text-sm font-semibold rounded-xl cursor-pointer shadow-md shadow-primary-600/20 hover:from-primary-700 hover:to-primary-800 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 font-sans">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
          送出許願
        </button>
      </form>

      <div id="js-success-msg" class="hidden mt-5 px-5 py-4 bg-emerald-50 border-l-3 border-emerald-500 text-emerald-700 rounded-lg font-medium text-sm">
        🎉 許願已成功送出！為了防範垃圾訊息，小編審核通過後就會出現在下方喔！
      </div>
    </div>

    <!-- Display area -->
    <div>
      <h3 class="flex items-center justify-center gap-2.5 text-xl font-bold text-slate-900 text-center mb-8">
        <span class="text-lg">🌟</span>
        社群許願展示區
      </h3>
      <div id="js-wishes-loading" class="flex items-center justify-center gap-3 text-slate-500 text-sm py-12">
        <div class="w-5 h-5 border-2 border-slate-200 border-t-primary-500 rounded-full animate-spin"></div>
        <span>載入中，請稍候...</span>
      </div>
      <div id="js-wishes-container" class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <!-- JS rendered -->
      </div>
    </div>
  </div>
</section>

<style is:global>
  @reference "../styles/global.css";
  .flip-card {
    @apply bg-transparent cursor-pointer;
    height: 300px;
    perspective: 1000px;
  }
  .flip-card-inner {
    @apply relative w-full h-full text-center rounded-2xl;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
  }
  .flip-card:hover .flip-card-inner,
  .flip-card:focus .flip-card-inner {
    transform: rotateY(180deg);
  }
  .flip-card-front, .flip-card-back {
    @apply absolute inset-0 rounded-2xl p-6 flex flex-col justify-between items-center;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-card-front {
    @apply bg-white text-slate-800 border border-slate-200 shadow-sm;
  }
  .flip-card-back {
    @apply text-slate-50 items-start text-left;
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    transform: rotateY(180deg);
  }
  .card-badge {
    @apply self-end bg-primary-500/8 text-primary-600 px-3 py-1 rounded-full text-xs font-semibold;
  }
  .avatar-placeholder {
    @apply w-14 h-14 rounded-full flex items-center justify-center text-2xl;
    background: linear-gradient(135deg, #38bdf8, #818cf8);
  }
  .card-wish-title {
    @apply text-lg text-slate-900 font-bold my-2;
  }
  .card-wish-desc {
    @apply text-sm text-slate-500 leading-relaxed text-center flex-1;
  }
  .back-title {
    @apply text-base text-sky-400 font-bold mb-3 pb-2.5 w-full;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .back-content {
    @apply text-sm leading-relaxed flex-1;
  }
  .back-content p {
    @apply mb-2.5;
  }
  .back-content strong {
    @apply text-sky-400;
  }
  .flip-hint {
    @apply text-xs text-slate-400;
  }
  .flip-hint-back {
    @apply text-xs text-white/40 self-center;
  }
</style>

<script>
  const GOOGLE_SHEET_CSV_URL = import.meta.env.PUBLIC_GOOGLE_SHEET_CSV_URL;
  const GOOGLE_FORM_ACTION_URL = import.meta.env.PUBLIC_GOOGLE_FORM_ACTION_URL;

  const form = document.getElementById('js-wish-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('js-success-msg');
  const container = document.getElementById('js-wishes-container');
  const loadingStatus = document.getElementById('js-wishes-loading');

  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const searchParams = new URLSearchParams();
      for (const [key, value] of formData) {
        searchParams.append(key, value.toString());
      }
      try {
        await fetch(GOOGLE_FORM_ACTION_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: searchParams
        });
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
      } catch (err) {
        console.error('送出失敗', err);
        alert('許願送出失敗，請檢查網路連線或稍後再試！');
      }
    });
  }

  async function loadWishes() {
    if (!container || !loadingStatus) return;
    if (!GOOGLE_SHEET_CSV_URL) {
      loadingStatus.textContent = '請先設定 PUBLIC_GOOGLE_SHEET_CSV_URL 環境變數。';
      return;
    }
    try {
      const response = await fetch(GOOGLE_SHEET_CSV_URL);
      if (!response.ok) throw new Error('無法取得 Google Sheet 資料');
      const csvText = await response.text();
      const rows = parseCSV(csvText);

      const wishes = rows.slice(1)
        .map((row, index) => ({
          id: index, title: row[1] || '', description: row[2] || '',
          painPoint: row[3] || '', superpower: row[4] || '',
          progress: row[5] || '',
          isApproved: (row[6] || '').trim().toUpperCase() === 'Y'
        }))
        .filter(wish => wish.isApproved && wish.title);

      loadingStatus.classList.add('hidden');

      if (wishes.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center text-slate-500 py-12 text-sm">目前尚無審核通過的許願專案，快來當第一個許願者吧！</div>`;
        return;
      }

      container.innerHTML = wishes.map(wish => `
        <div class="flip-card" tabindex="0">
          <div class="flip-card-inner">
            <div class="flip-card-front">
              <div class="card-badge">${escapeHTML(wish.progress)}</div>
              <div class="avatar-placeholder">💡</div>
              <h4 class="card-wish-title">${escapeHTML(wish.title)}</h4>
              <p class="card-wish-desc">${escapeHTML(wish.description)}</p>
              <div class="flip-hint">💡 懸停或點擊翻面查看需求</div>
            </div>
            <div class="flip-card-back">
              <h4 class="back-title">專案需求詳情</h4>
              <div class="back-content">
                <p><strong>現況痛點：</strong>${escapeHTML(wish.painPoint)}</p>
                <p><strong>極需支援：</strong>${escapeHTML(wish.superpower)}</p>
                <p><strong>目前進度：</strong>${escapeHTML(wish.progress)}</p>
              </div>
              <div class="flip-hint-back">🔄 移開或再次點擊翻回</div>
            </div>
          </div>
        </div>
      `).join('');
    } catch (err) {
      console.error(err);
      loadingStatus.textContent = '載入許願池資料失敗，請重新整理網頁。';
    }
  }

  function parseCSV(text: string): string[][] {
    const lines: string[][] = [];
    let row: string[] = [''];
    let inQuotes = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i]; const next = text[i + 1];
      if (c === '"') {
        if (inQuotes && next === '"') { row[row.length - 1] += '"'; i++; }
        else { inQuotes = !inQuotes; }
      } else if (c === ',' && !inQuotes) { row.push(''); }
      else if ((c === '\r' || c === '\n') && !inQuotes) {
        if (c === '\r' && next === '\n') i++;
        lines.push(row); row = [''];
      } else { row[row.length - 1] += c; }
    }
    if (row.length > 1 || row[0] !== '') lines.push(row);
    return lines;
  }

  function escapeHTML(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  loadWishes();
</script>