---
// WishPool — 前端 JS 撈取 Google Sheet
---

<section id="wish-pool" class="home-section">
  <div class="wrap">
    <div class="home-head">
      <h2 class="home-title">想做但還沒有人做的事</h2>
      <p class="home-lede">寫下來，社群裡就有人看得到。送出後會先經過人工審核，才會出現在左邊。</p>
    </div>

    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.65fr)] lg:gap-12">
    <!-- 已經有人許過的願（左） -->
    <div class="lg:order-1">
      <h3 class="m-0 mb-4 text-sm font-semibold" style="color:var(--ink)">已經有人許過的願</h3>
      <div id="js-wishes-loading" class="grid grid-cols-1 gap-3 sm:grid-cols-2" aria-hidden="true">
        <div class="h-[160px] animate-pulse rounded-[10px]" style="background:var(--surface-2)"></div>
        <div class="h-[160px] animate-pulse rounded-[10px]" style="background:var(--surface-2)"></div>
      </div>
      <div id="js-wishes-container" class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <!-- JS rendered -->
      </div>
    </div>

    <!-- 許願表單（右） -->
    <div class="rounded-[10px] border p-5 sm:p-6 lg:sticky lg:top-24 lg:order-2" style="border-color:var(--line);background:var(--surface)">
      <h3 class="m-0 mb-5 text-sm font-semibold" style="color:var(--ink)">許一個願</h3>
      <form id="js-wish-form" class="space-y-5">
        <div>
          <label for="wish-q1" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">1</span>
            給專案取個酷名字：如「真的假的」、「阿美語萌典」，好記又有個性。
          </label>
          <input type="text" id="wish-q1" name={import.meta.env.PUBLIC_ENTRY_TITLE} required placeholder="請輸入專案名稱..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q2" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">2</span>
            一句話形容這個專案：透過 [技術] 解決 [誰] 的 [什麼痛點]。
          </label>
          <input type="text" id="wish-q2" name={import.meta.env.PUBLIC_ENTRY_DESCRIPTION} required placeholder="請輸入一句話形容..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q3" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">3</span>
            現有工具的不足：為什麼現在的方法行不通？
          </label>
          <textarea id="wish-q3" name={import.meta.env.PUBLIC_ENTRY_PAINPOINT} rows="3" required placeholder="請描述目前的困境與不足..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)"></textarea>
        </div>

        <div>
          <label for="wish-q4" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">4</span>
            需要的超能力：（例如：徵求會用 ______ 的人）。
          </label>
          <input type="text" id="wish-q4" name={import.meta.env.PUBLIC_ENTRY_SUPERPOWER} required placeholder="例如：徵求會寫 React / 需要 UI 設計師..."
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)" />
        </div>

        <div>
          <label for="wish-q5" class="mb-2 flex items-start gap-2.5 text-sm font-medium leading-snug" style="color:var(--ink-2)">
            <span class="num mt-0.5 inline-flex h-[22px] min-w-[22px] shrink-0 items-center justify-center rounded-full text-[0.7rem]" style="background:var(--accent-soft);color:var(--accent-ink)">5</span>
            目前的進度：
          </label>
          <select id="wish-q5" name={import.meta.env.PUBLIC_ENTRY_PROGRESS} required
            class="w-full rounded-lg border px-3.5 py-2.5 text-sm transition-colors duration-150 focus:outline-none" style="border-color:var(--line);background:var(--paper);color:var(--ink)">
            <option value="" disabled selected>-- 請選擇目前進度 --</option>
            <option value="已有構想">已有構想</option>
            <option value="已有草稿">已有草稿</option>
            <option value="已有資料">已有資料</option>
          </select>
        </div>

        <button type="submit"
          class="inline-flex w-full cursor-pointer items-center justify-center gap-2 rounded-lg border-none py-3 text-sm font-medium transition-transform duration-200 hover:-translate-y-0.5 active:scale-[0.99]" style="background:var(--accent-fill);color:var(--on-accent)">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
          送出許願
        </button>
      </form>

      <div id="js-success-msg" class="mt-5 hidden rounded-lg border-l-2 px-4 py-3 text-sm" style="border-color:var(--accent);background:var(--accent-soft);color:var(--accent-ink)">
        已送出。為了擋掉灌水，會先經過人工審核才會出現在下方。
      </div>
    </div>

    </div>
  </div>
</section>

<style is:global>
  /* 願望卡跟專案卡同一種長相：靠左、細框、圓角 10px。舊版的翻面卡把需求藏在背面，看不到就等於沒寫 */
  .wish-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.2rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }
  .wish-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem; }
  .wish-title { margin: 0; font-size: 1.02rem; font-weight: 600; line-height: 1.45; color: var(--ink); }
  .wish-badge {
    flex-shrink: 0;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .wish-desc { margin: 0; font-size: 0.88rem; line-height: 1.7; color: var(--ink-2); overflow-wrap: anywhere; }
  .wish-meta { display: grid; gap: 0.45rem; margin: 0.2rem 0 0; padding-top: 0.7rem; border-top: 1px solid var(--line); }
  .wish-meta dt { font-size: 0.72rem; color: var(--ink-muted); }
  .wish-meta dd { margin: 0.1rem 0 0; font-size: 0.84rem; line-height: 1.65; color: var(--ink-muted); overflow-wrap: anywhere; }
</style>

<script>
  const GOOGLE_SHEET_CSV_URL = import.meta.env.PUBLIC_GOOGLE_SHEET_CSV_URL;
  const GOOGLE_FORM_ACTION_URL = import.meta.env.PUBLIC_GOOGLE_FORM_ACTION_URL;

  const form = document.getElementById('js-wish-form') as HTMLFormElement | null;
  const successMsg = document.getElementById('js-success-msg');
  const container = document.getElementById('js-wishes-container');
  const loadingStatus = document.getElementById('js-wishes-loading');

  if (form && successMsg) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const searchParams = new URLSearchParams();
      for (const [key, value] of formData) {
        searchParams.append(key, value.toString());
      }
      try {
        await fetch(GOOGLE_FORM_ACTION_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: searchParams
        });
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
      } catch (err) {
        // 不要用 window.alert：它會擋住整個頁面，而且長得像瀏覽器出錯。
        // 錯誤訊息就寫在表單旁邊，使用者才知道自己填的東西還在。
        console.error('送出失敗', err);
        successMsg.textContent = '送不出去，可能是網路的問題。你填的內容還在，稍後再按一次送出。';
        successMsg.classList.remove('hidden');
      }
    });
  }

  async function loadWishes() {
    if (!container || !loadingStatus) return;
    if (!GOOGLE_SHEET_CSV_URL) {
      loadingStatus.textContent = '請先設定 PUBLIC_GOOGLE_SHEET_CSV_URL 環境變數。';
      return;
    }
    try {
      const response = await fetch(GOOGLE_SHEET_CSV_URL);
      if (!response.ok) throw new Error('無法取得 Google Sheet 資料');
      const csvText = await response.text();
      const rows = parseCSV(csvText);

      const wishes = rows.slice(1)
        .map((row, index) => ({
          id: index, title: row[1] || '', description: row[2] || '',
          painPoint: row[3] || '', superpower: row[4] || '',
          progress: row[5] || '',
          isApproved: (row[6] || '').trim().toUpperCase() === 'Y'
        }))
        .filter(wish => wish.isApproved && wish.title);

      loadingStatus.classList.add('hidden');

      if (wishes.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-sm" style="color:var(--ink-muted)">目前尚無審核通過的許願專案，快來當第一個許願者吧！</div>`;
        return;
      }

      container.innerHTML = wishes.map(wish => `
        <article class="wish-card">
          <div class="wish-top">
            <h4 class="wish-title">${escapeHTML(wish.title)}</h4>
            ${wish.progress ? `<span class="wish-badge">${escapeHTML(wish.progress)}</span>` : ''}
          </div>
          <p class="wish-desc">${escapeHTML(wish.description)}</p>
          <dl class="wish-meta">
            ${wish.painPoint ? `<div><dt>現在的問題</dt><dd>${escapeHTML(wish.painPoint)}</dd></div>` : ''}
            ${wish.superpower ? `<div><dt>需要的人</dt><dd>${escapeHTML(wish.superpower)}</dd></div>` : ''}
          </dl>
        </article>
      `).join('');
    } catch (err) {
      console.error(err);
      loadingStatus.textContent = '載入許願池資料失敗，請重新整理網頁。';
    }
  }

  function parseCSV(text: string): string[][] {
    const lines: string[][] = [];
    let row: string[] = [''];
    let inQuotes = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i]; const next = text[i + 1];
      if (c === '"') {
        if (inQuotes && next === '"') { row[row.length - 1] += '"'; i++; }
        else { inQuotes = !inQuotes; }
      } else if (c === ',' && !inQuotes) { row.push(''); }
      else if ((c === '\r' || c === '\n') && !inQuotes) {
        if (c === '\r' && next === '\n') i++;
        lines.push(row); row = [''];
      } else { row[row.length - 1] += c; }
    }
    if (row.length > 1 || row[0] !== '') lines.push(row);
    return lines;
  }

  function escapeHTML(str: string): string {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  loadWishes();
</script>