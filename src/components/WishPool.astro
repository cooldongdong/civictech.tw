---
// 首頁的許願池入口。只放最新三個提案與兩個入口：許願在 /w/new，完整列表在 /w。
// 提案會一直增加，所以首頁只放固定幾張，不讓這一區無限長下去。
// id 留著 wish-pool：舊版就是這個錨點，外面可能有人貼過 civictech.tw/#wish-pool
import WishCard from "./WishCard.astro";
import { getWishes } from "../lib/wishes";

const wishes = await getWishes();
const latest = wishes.slice(0, 3);
---

<section id="wish-pool" class="py-16 sm:py-20 lg:py-24">
  <div class="wrap">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <h2 class="m-0 max-w-[20ch] text-[1.7rem] font-semibold sm:text-[2.1rem]" style="color:var(--ink)">
        想做但還沒有人做的事
      </h2>
      <p class="m-0 max-w-[40ch] text-sm" style="color:var(--ink-muted)">
        寫下來，社群裡就有人看得到。每個提案都會進 g0v Slack，讓想一起做的人接著聊。
      </p>
    </div>

    {latest.length > 0 ? (
      <div class="grid gap-3 md:grid-cols-3">
        {latest.map((w, i) => <WishCard wish={w} index={i} />)}
      </div>
    ) : (
      <p class="m-0 rounded-lg border p-6 text-center text-sm" style="border-color:var(--line);color:var(--ink-muted)">
        目前還沒有提案，來當第一個許願的人吧。
      </p>
    )}

    <nav aria-label="許願池" class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/w/new"
        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium no-underline transition-transform duration-200 hover:-translate-y-0.5"
        style="background:var(--accent-fill);color:var(--on-accent)"
      >
        我也想許願
      </a>
      {wishes.length > 0 && (
        <a href="/w" class="ml-auto text-sm" style="color:var(--accent)">看全部 {wishes.length} 個提案 →</a>
      )}
    </nav>
  </div>
</section>
