---
// 黑客松鼠。畫法跟許願池的湖中女神同一套：純色塊、彎弧閉眼、淡腮紅、金色點綴。
// 姿勢照 Dong 給的紅松鼠照片：身體前傾、一隻前腳撐地、另一隻手高舉過頭打招呼，頭微微歪。
// 撐地的那隻手邊放一顆金色松果——收集專案的松鼠。
// 顏色走 CSS 變數，深色模式在 AskSquirrel.astro 裡換。
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: cls } = Astro.props;
---

<svg
  class:list={["squirrel", cls]}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  aria-hidden="true"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  <!-- 尾巴：在身後左側往上捲 -->
  <path
    d="M40 100 C14 102 4 80 10 60 C15 44 30 40 36 50 C40 58 30 62 28 70 C26 80 34 90 44 92 Z"
    fill="var(--sq-fur)"
    stroke="var(--sq-edge)"
    stroke-width="2.5"></path>

  <!-- 高舉的手：肩膀往右上，手肘彎一下，手掌在頭的右上方。先畫粗的描邊色、再畫細的毛色，就是一隻有外框的手臂 -->
  <g class="sq-wave">
    <path d="M74 74 C86 70 92 58 96 46 C98 38 100 32 102 26" fill="none" stroke="var(--sq-edge)" stroke-width="13"></path>
    <path d="M74 74 C86 70 92 58 96 46 C98 38 100 32 102 26" fill="none" stroke="var(--sq-fur)" stroke-width="8"></path>
    <ellipse cx="103" cy="23" rx="6" ry="5" fill="var(--sq-fur)" stroke="var(--sq-edge)" stroke-width="2.5"></ellipse>
    <!-- 張開的指頭 -->
    <path d="M100 18 L99 14 M104 17 L105 13 M108 20 L111 17" stroke="var(--sq-edge)" stroke-width="2"></path>
  </g>

  <!-- 身體：前傾，下寬上窄 -->
  <path
    d="M40 106 C34 90 38 72 50 66 C60 61 74 64 80 74 C88 86 86 100 80 108 Z"
    fill="var(--sq-fur)"
    stroke="var(--sq-edge)"
    stroke-width="2.5"></path>
  <!-- 白肚子 -->
  <path d="M50 106 C46 92 50 76 60 72 C70 74 74 90 70 106 Z" fill="var(--sq-belly)"></path>
  <!-- 後腿 -->
  <ellipse cx="80" cy="98" rx="9" ry="11" fill="var(--sq-fur)" stroke="var(--sq-edge)" stroke-width="2.5"></ellipse>

  <!-- 撐地的手 -->
  <path d="M48 76 C44 86 42 96 42 106" fill="none" stroke="var(--sq-edge)" stroke-width="12"></path>
  <path d="M48 76 C44 86 42 96 42 106" fill="none" stroke="var(--sq-fur)" stroke-width="7"></path>
  <ellipse cx="41" cy="108" rx="7" ry="4" fill="var(--sq-fur)" stroke="var(--sq-edge)" stroke-width="2.5"></ellipse>

  <!-- 地上的松果 -->
  <ellipse cx="26" cy="106" rx="5" ry="6" fill="#e8b23a"></ellipse>
  <path d="M20.4 102.6 Q26 97.4 31.6 102.6 Z" fill="#a8741a"></path>
  <path d="M26 98.4 L27.4 95.6" stroke="#a8741a" stroke-width="1.8"></path>

  <!-- 頭：往左歪一點 -->
  <g transform="rotate(-10 56 48)">
    <!-- 耳朵：高高豎起，尖端一撮毛 -->
    <path d="M38 38 L36 12 L52 30 Z" fill="var(--sq-fur)" stroke="var(--sq-edge)" stroke-width="2.5"></path>
    <path d="M74 38 L76 12 L60 30 Z" fill="var(--sq-fur)" stroke="var(--sq-edge)" stroke-width="2.5"></path>
    <!-- 耳尖那撮毛：實心的小火焰形，畫成線會像觸角 -->
    <path d="M33 16 Q30 8 35 3 Q35 9 39 14 Z" fill="var(--sq-edge)"></path>
    <path d="M79 16 Q82 8 77 3 Q77 9 73 14 Z" fill="var(--sq-edge)"></path>
    <path d="M40 32 L39 20 L47 29 Z" fill="var(--sq-ear)"></path>
    <path d="M72 32 L73 20 L65 29 Z" fill="var(--sq-ear)"></path>

    <ellipse cx="56" cy="48" rx="22" ry="19" fill="var(--sq-head)" stroke="var(--sq-edge)" stroke-width="2.5"></ellipse>
    <ellipse cx="56" cy="56" rx="10" ry="7" fill="var(--sq-belly)"></ellipse>
    <!-- 腮紅 -->
    <ellipse cx="41" cy="55" rx="4.5" ry="2.8" fill="#e98a8a" opacity="0.4"></ellipse>
    <ellipse cx="71" cy="55" rx="4.5" ry="2.8" fill="#e98a8a" opacity="0.4"></ellipse>
    <!-- 彎弧閉眼，跟女神一樣 -->
    <path d="M44 47 A4.5 4.5 0 0 0 52 47" fill="none" stroke="var(--sq-ink)" stroke-width="2.4"></path>
    <path d="M60 47 A4.5 4.5 0 0 0 68 47" fill="none" stroke="var(--sq-ink)" stroke-width="2.4"></path>
    <!-- 鼻子與 ω 嘴 -->
    <ellipse cx="56" cy="53" rx="2.6" ry="2" fill="var(--sq-ink)"></ellipse>
    <path d="M51 57 Q53.5 60 56 57 Q58.5 60 61 57" fill="none" stroke="var(--sq-ink)" stroke-width="1.8"></path>
  </g>
</svg>
