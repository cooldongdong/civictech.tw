---
// 黑客松鼠。畫法跟許願池的湖中女神同一套：不描邊、純色塊疊色、淡腮紅、金色點綴。
// 穿網站主色的帽 T、雙手扶著筆電，背蓋上是一顆金色松果——收集專案的松鼠，也是寫程式的黑客。
// 顏色走 --sq-* 變數，深色模式在 AskSquirrel.astro 裡換。
//
// viewBox 不是 0 0 120 120：尾巴在左邊，臉放正中間時整隻看起來偏左；
// 照色塊重心（x = 50.1）置中又變成臉太右。水平取兩者中間 x = 55，是放進圓形按鈕實際比過五個位置挑的。
// 垂直照外框（耳尖到腳底）置中。
//
// crop="head" 只取頭（含耳朵與一點帽 T 領口），給右下角那顆小按鈕用：
// 整隻放進 46px 時臉只剩十幾 px，認不出是松鼠。
interface Props {
  size?: number;
  class?: string;
  crop?: "full" | "head";
}
const { size = 48, class: cls, crop = "full" } = Astro.props;
const viewBox = crop === "head" ? "22 2 76 76" : "-3 2 116 116";
---

<svg
  class:list={["squirrel", cls]}
  width={size}
  height={size}
  viewBox={viewBox}
  aria-hidden="true"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  <!-- 腳下的影子 -->
  <ellipse cx="60" cy="114" rx="31" ry="3.6" fill="var(--sq-ink)" opacity="0.08"/>

  <!-- 尾巴：蓬鬆的 S 形，在身後左側往上捲 -->
  <path d="M50 109 C28 113 7 100 7 75 C7 54 17 38 30 31 C41 25 53 29 51 40 C50 47 43 48 38.5 51.5 C30.5 57.5 29 69 33 80 C36 90 43 98 50 102 Z" fill="var(--sq-tail)"/>
  <path d="M45 105 C28 105 14 93 14 75 C14 59 21 46 31 39" fill="none" stroke="var(--sq-tail2)" stroke-width="3.4" opacity="0.75"/>

  <!-- 身體：帽 T。上緣伸進下巴底下，頭跟身體才接得起來 -->
  <path d="M37 112 C35 99 36 86 41 79.5 C45 74.5 52 72.5 60 72.5 C68 72.5 75 74.5 79 79.5 C84 86 85 99 83 112 Z" fill="var(--sq-hoodie)"/>
  <!-- 帽子：墊在脖子後面的一圈 -->
  <path d="M45 76 C47 70.5 73 70.5 75 76 C71 78.5 49 78.5 45 76 Z" fill="var(--sq-hoodie2)"/>
  <path d="M56 77.5 L55.5 83 M64 77.5 L64.5 83" stroke="var(--sq-cream)" stroke-width="1.3"/>
  <circle cx="55.4" cy="83.8" r="1.1" fill="var(--sq-cream)"/>
  <circle cx="64.6" cy="83.8" r="1.1" fill="var(--sq-cream)"/>

  <!-- 腳 -->
  <path d="M43 113.2 C43 109.6 46 108 49.5 108 C53 108 56 109.6 56 113.2 C56 114.4 55 115 53.8 115 L45.2 115 C44 115 43 114.4 43 113.2 Z" fill="var(--sq-fur2)"/>
  <path d="M64 113.2 C64 109.6 67 108 70.5 108 C74 108 77 109.6 77 113.2 C77 114.4 76 115 74.8 115 L66.2 115 C65 115 64 114.4 64 113.2 Z" fill="var(--sq-fur2)"/>
  <path d="M47.6 112.4 L47.6 115 M51.4 112.4 L51.4 115 M68.6 112.4 L68.6 115 M72.4 112.4 L72.4 115" stroke="var(--sq-fur3)" stroke-width="1"/>

  <!-- 耳朵 -->
  <path d="M38 36 C33.5 24 35 12 41.5 5 C48.5 12 52.5 21 51 31 Z" fill="var(--sq-fur)"/>
  <path d="M41.5 5 C40 7.5 38.6 10 37.8 12.6 C40.6 11.6 43.6 11.4 46.2 12 C44.8 9.4 43.3 7.2 41.5 5 Z" fill="var(--sq-fur2)"/>
  <path d="M41.3 31.5 C39.4 25 40 19 42.3 15 C45.8 18.6 47.8 23 47.6 28.6 Z" fill="var(--sq-ear)"/>
  <path d="M82 36 C86.5 24 85 12 78.5 5 C71.5 12 67.5 21 69 31 Z" fill="var(--sq-fur)"/>
  <path d="M78.5 5 C80 7.5 81.4 10 82.2 12.6 C79.4 11.6 76.4 11.4 73.8 12 C75.2 9.4 76.7 7.2 78.5 5 Z" fill="var(--sq-fur2)"/>
  <path d="M78.7 31.5 C80.6 25 80 19 77.7 15 C74.2 18.6 72.2 23 72.4 28.6 Z" fill="var(--sq-ear)"/>

  <!-- 頭：兩頰鼓起的豆子形 -->
  <path d="M34 50 C32 34 44 24 60 24 C76 24 88 34 86 50 C90 54 89 62 83 64.5 C77 70.5 69 73 60 73 C51 73 43 70.5 37 64.5 C31 62 30 54 34 50 Z" fill="var(--sq-fur)"/>
  <path d="M55.5 26 C57 20.5 62.5 19.5 65 23.5 C62.5 22.6 60.3 23.4 59.2 26.2 Z" fill="var(--sq-fur2)"/>
  <ellipse cx="60" cy="60" rx="11.5" ry="8.4" fill="var(--sq-cream)"/>

  <!-- 睜眼 -->
  <ellipse cx="48" cy="50" rx="3.2" ry="4" fill="var(--sq-ink)"/>
  <ellipse cx="72" cy="50" rx="3.2" ry="4" fill="var(--sq-ink)"/>
  <circle cx="49.1" cy="48.4" r="1.2" fill="#fff"/>
  <circle cx="73.1" cy="48.4" r="1.2" fill="#fff"/>

  <ellipse cx="42.5" cy="58.5" rx="4.4" ry="2.5" fill="var(--sq-blush)" opacity="0.5"/>
  <ellipse cx="77.5" cy="58.5" rx="4.4" ry="2.5" fill="var(--sq-blush)" opacity="0.5"/>

  <!-- 鼻子、嘴、門牙 -->
  <path d="M57.3 55.2 Q60 53.6 62.7 55.2 Q61.6 58 60 58.2 Q58.4 58 57.3 55.2 Z" fill="var(--sq-ink)"/>
  <path d="M60 58.2 L60 60" stroke="var(--sq-ink)" stroke-width="1.2"/>
  <path d="M60 60.2 Q57.4 62.6 55 59.8 M60 60.2 Q62.6 62.6 65 59.8" fill="none" stroke="var(--sq-ink)" stroke-width="1.4"/>
  <rect x="57.9" y="60.6" width="4.2" height="4.2" rx="1.1" fill="#fff" stroke="var(--sq-ink)" stroke-width="0.9"/>
  <path d="M60 61 L60 64.4" stroke="var(--sq-ink)" stroke-width="0.7"/>

  <!-- 筆電：從背面看，螢幕朝著松鼠。銀色，跟深青色帽 T 拉開 -->
  <rect x="43" y="86" width="34" height="22" rx="3" fill="var(--sq-laptop)"/>
  <rect x="41" y="107" width="38" height="3.2" rx="1.6" fill="var(--sq-laptop2)"/>
  <!-- 背蓋上的金色松果 -->
  <path d="M56 96 C56 100.5 57.6 103.6 60 104.4 C62.4 103.6 64 100.5 64 96 Z" fill="#e8b23a"/>
  <path d="M60 92.6 L60.9 90.2" stroke="#a8741a" stroke-width="1.5"/>
  <path d="M55 96.6 C55 93.8 57.2 92.2 60 92.2 C62.8 92.2 65 93.8 65 96.6 Z" fill="#a8741a"/>

  <!-- 扶著螢幕上緣的兩隻手：袖子從肩膀長出來往內收，手掌搭在螢幕上緣 -->
  <path d="M41.5 79.5 C38.5 83 38.5 88 41 90.5 C43 92 46 91.5 47.5 89.5 L48.5 85 C46 84 44 82 43.6 78.6 Z" fill="var(--sq-hoodie2)"/>
  <path d="M78.5 79.5 C81.5 83 81.5 88 79 90.5 C77 92 74 91.5 72.5 89.5 L71.5 85 C74 84 76 82 76.4 78.6 Z" fill="var(--sq-hoodie2)"/>
  <path d="M44.5 89.2 C44.2 86.2 45.8 84.2 48.4 84.2 C51 84.2 52.8 85.8 52.8 88.4 C52.8 89.8 51.8 90.6 50.4 90.6 L46.2 90.6 C45.2 90.6 44.6 90.1 44.5 89.2 Z" fill="var(--sq-fur2)"/>
  <path d="M75.5 89.2 C75.8 86.2 74.2 84.2 71.6 84.2 C69 84.2 67.2 85.8 67.2 88.4 C67.2 89.8 68.2 90.6 69.6 90.6 L73.8 90.6 C74.8 90.6 75.4 90.1 75.5 89.2 Z" fill="var(--sq-fur2)"/>
  <path d="M47.6 86 L47.6 88 M50.2 86 L50.2 88 M72.4 86 L72.4 88 M69.8 86 L69.8 88" stroke="var(--sq-fur3)" stroke-width="0.9"/>
</svg>
