---
import knowHowData from "../content/knowhow/data.json";

const videoSrc = `${import.meta.env.BASE_URL}/videos/hero-background.mp4`.replace(/\/\//g, "/");
const posterSrc = `${import.meta.env.BASE_URL}/images/hero-poster.png`.replace(/\/\//g, "/");
const totalCount = knowHowData.length;
---

<section id="hero" class="relative w-full h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Video background -->
  <div class="absolute inset-0 z-0">
    <video autoplay loop muted playsinline poster={posterSrc} class="w-full h-full object-cover object-center">
      <source src={videoSrc} type="video/mp4" />
    </video>
    <!-- Overlay: fades with content -->
    <div id="hero-overlay" class="hero-overlay absolute inset-0"></div>
  </div>

  <!-- Content: auto-hides after idle -->
  <div id="hero-content" class="hero-content relative z-10 text-center text-white px-6 w-full max-w-3xl">

    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-5 tracking-tight leading-[1.2]">
      台灣公民科技資料庫
    </h1>

    <p class="text-sm sm:text-base text-white/80 mb-8 leading-relaxed max-w-lg mx-auto">
      探索、協作、自主開源，連結數位公民的實踐指南
    </p>

    <!-- Stats row -->
    <div class="flex items-center justify-center gap-8 sm:gap-12 mb-10">
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-white leading-none mb-1">350+</div>
        <div class="text-[0.7rem] text-white/50 font-medium tracking-wide uppercase">公民科技專案</div>
      </div>
      <div class="w-px h-8 bg-white/20"></div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-extrabold text-white leading-none mb-1">{totalCount}</div>
        <div class="text-[0.7rem] text-white/50 font-medium tracking-wide uppercase">則行動指引</div>
      </div>
    </div>

    <!-- CTA -->
    <a href="#project-list" class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/20 text-white px-7 py-3 rounded-full text-sm font-semibold hover:bg-white/25 transition-all duration-300">
      探索專案清單
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19" />
        <polyline points="19 12 12 19 5 12" />
      </svg>
    </a>
  </div>

  <!-- Scroll indicator (also auto-hides) -->
  <div id="hero-scroll" class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="w-6 h-9 border-2 border-white/25 rounded-xl flex justify-center pt-2">
      <div class="w-0.5 h-2 bg-white/50 rounded-full animate-scroll-down"></div>
    </div>
  </div>
</section>

<style>
  /* Overlay */
  .hero-overlay {
    background: linear-gradient(
      180deg,
      rgba(15, 23, 42, 0.45) 0%,
      rgba(15, 23, 42, 0.25) 40%,
      rgba(15, 23, 42, 0.50) 100%
    );
    opacity: 1;
    transition: opacity 1s ease-out;
  }

  .hero-overlay.faded {
    opacity: 0.15;
  }

  /* Content entrance + transition */
  .hero-content {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: opacity 1s ease-out, transform 1s ease-out;
  }

  .hero-content.hidden-idle {
    opacity: 0;
    transform: translateY(1rem);
    pointer-events: none;
  }

  /* Scroll indicator */
  #hero-scroll {
    transition: opacity 1s ease-out;
  }

  #hero-scroll.hidden-idle {
    opacity: 0;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes scroll-down {
    0%   { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(10px); }
  }

  .animate-scroll-down {
    animation: scroll-down 1.5s infinite;
  }
</style>

<script>
  const content = document.getElementById("hero-content") as HTMLElement | null;
  const scrollIndicator = document.getElementById("hero-scroll");
  const overlay = document.getElementById("hero-overlay");
  const heroSection = document.getElementById("hero");

  // Remove the entrance animation once it finishes so CSS transitions can take over.
  // animation-fill-mode: both holds opacity:1 indefinitely and overrides .hidden-idle.
  content?.addEventListener("animationend", () => {
    if (content) content.style.animation = "none";
  }, { once: true });

  let idleTimer: ReturnType<typeof setTimeout> | null = null;
  const IDLE_DELAY = 4000; // 4 秒無動作後隱藏

  function showContent() {
    content?.classList.remove("hidden-idle");
    scrollIndicator?.classList.remove("hidden-idle");
    overlay?.classList.remove("faded");
  }

  function hideContent() {
    content?.classList.add("hidden-idle");
    scrollIndicator?.classList.add("hidden-idle");
    overlay?.classList.add("faded");
  }

  function resetIdleTimer() {
    // 只在 hero 區域可見時啟動 idle 計時
    if (!isHeroVisible) return;
    showContent();
    if (idleTimer) clearTimeout(idleTimer);
    idleTimer = setTimeout(hideContent, IDLE_DELAY);
  }

  // Track if hero section is in viewport
  let isHeroVisible = true;
  const heroObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        isHeroVisible = entry.isIntersecting;
        if (isHeroVisible) {
          resetIdleTimer();
        } else {
          // 離開 hero 區域時清除計時器，保持內容顯示狀態
          if (idleTimer) clearTimeout(idleTimer);
          showContent();
        }
      });
    },
    { threshold: 0.3 }
  );

  if (heroSection) heroObserver.observe(heroSection);

  // 監聽使用者互動事件
  const events = ["mousemove", "touchstart", "click", "keydown", "scroll"];
  events.forEach((evt) => {
    window.addEventListener(evt, resetIdleTimer, { passive: true });
  });

  // 初始啟動計時器
  resetIdleTimer();
</script>
