---
// src/components/SurveyPopup.astro — 角落滑入式問卷邀請（捲動一段距離後才出現，可關閉）
// 抽獎截止（7/2 24:00 台灣時間）一過，前端自動把抽獎相關文案降級為純問卷邀請。
---

<div
  id="survey-popup"
  class="fixed bottom-5 right-5 z-50 w-[calc(100%-2.5rem)] sm:w-[336px] translate-y-6 opacity-0 pointer-events-none transition-all duration-500 ease-out"
>
  <div class="popup-card relative rounded-2xl p-5">
    <button
      id="survey-popup-close"
      type="button"
      aria-label="關閉"
      class="popup-close absolute top-3 right-3 w-7 h-7 flex items-center justify-center rounded-full transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <span id="survey-popup-badge" class="inline-block text-xs font-semibold px-3 py-1 rounded-full mb-3 tracking-wide" style="background:var(--accent-soft);color:var(--accent-ink)">
      🎁 填問卷．抽好禮
    </span>
    <h3 class="text-base font-bold mb-1.5 pr-6 leading-snug" style="color:var(--ink)">
      幫指引補上你的那一塊
    </h3>
    <p id="survey-popup-desc" class="text-[0.8rem] leading-relaxed mb-2" style="color:var(--ink-2)">
      花幾分鐘分享你的公民科技經驗，幫指引長出下一則。<strong class="font-bold" style="color:var(--gap)">7/2（四）前</strong>完整填答並留下 email，就能參加 g0v jothon 抽獎！
    </p>
    <p class="text-[0.7rem] leading-snug mb-4" style="color:var(--ink-muted)">
      問卷將持續開放，隨時歡迎填寫分享 🙌
    </p>

    <div class="flex items-center gap-3">
      <a
        id="survey-popup-cta"
        href="https://forms.gle/u5Vr74hRjxNLm1tr9"
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 inline-flex items-center justify-center gap-1.5 btn-fill py-2.5 px-4 text-xs font-semibold rounded-lg hover:-translate-y-0.5 transition-all duration-300 no-underline"
      >
        立即填問卷
      </a>
      <a
        id="survey-popup-draw"
        href="https://g0v.hackmd.io/oGgBQVosTvKs_cdiQUQDaA?view"
        target="_blank"
        rel="noopener noreferrer"
        class="popup-link text-[0.7rem] transition-colors whitespace-nowrap"
      >
        抽獎辦法 →
      </a>
    </div>
  </div>
</div>

<script>
  const popup = document.getElementById("survey-popup");
  const closeBtn = document.getElementById("survey-popup-close");
  const DISMISS_KEY = "survey-popup-dismissed";
  const hiddenClasses = ["translate-y-6", "opacity-0", "pointer-events-none"];

  // 抽獎截止（7/2 24:00 台灣時間）一過，自動把抽獎相關文案降級為純問卷邀請
  const DRAW_DEADLINE = new Date("2026-07-02T23:59:59+08:00").getTime();
  if (Date.now() > DRAW_DEADLINE) {
    const badge = document.getElementById("survey-popup-badge");
    const desc = document.getElementById("survey-popup-desc");
    const cta = document.getElementById("survey-popup-cta");
    const drawLink = document.getElementById("survey-popup-draw");
    if (badge) badge.textContent = "🌱 邀請你共筆";
    if (desc) desc.textContent = "花幾分鐘分享你的公民科技經驗，幫指引長出下一則。歡迎完整填答，一起把指引補得更完整。";
    if (cta) cta.textContent = "填問卷分享";
    if (drawLink) drawLink.remove();
  }

  if (popup && !sessionStorage.getItem(DISMISS_KEY)) {
    // 這張先滑出；稍後跑咖松卡進來時會像「新訊息」把它往上擠
    window.setTimeout(() => {
      popup.classList.remove(...hiddenClasses);
    }, 800);

    closeBtn?.addEventListener("click", () => {
      popup.classList.add(...hiddenClasses);
      sessionStorage.setItem(DISMISS_KEY, "1"); // 本次瀏覽不再出現
    });
  }
</script>
