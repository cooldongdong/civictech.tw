---
// src/components/Footer.astro
---

<footer id="footer" class="relative bg-gradient-to-b from-slate-900 to-slate-950 text-slate-100 py-20 px-6 pb-10">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-sky-400/30 to-transparent"></div>

  <div class="max-w-4xl mx-auto">
    <!-- Content -->
    <div class="text-center mb-16">
      <span class="inline-block text-xs font-semibold text-sky-400 bg-sky-400/10 px-4 py-1.5 rounded-full mb-4 tracking-wide">
        🤝 一起協作
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold mb-3 bg-gradient-to-br from-white via-white to-sky-300 bg-clip-text text-transparent">
        參與公民科技，一起動手做
      </h2>
      <p class="text-base text-slate-400">
        我們的工作文件完全公開，隨時歡迎你的加入與反饋！
      </p>
    </div>

    <!-- Link cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-3xl mx-auto mb-16">
      <a href="https://g0v.hackmd.io/@jothon/civictech_doc" target="_blank" rel="noopener noreferrer"
         class="group flex items-center gap-4 bg-white/4 border border-white/6 p-5 rounded-2xl no-underline text-inherit transition-all duration-300 hover:bg-white/8 hover:border-sky-400/20 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20">
        <div class="w-12 h-12 flex items-center justify-center bg-sky-400/8 rounded-xl text-2xl shrink-0 transition-transform duration-300 group-hover:scale-110">
          📂
        </div>
        <div class="flex-1 text-left">
          <h3 class="text-base font-semibold text-slate-100 mb-1">工作文件</h3>
          <p class="text-xs text-slate-400 leading-snug">瀏覽共筆、會議記錄與專案規劃文件</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-slate-600 transition-all duration-300 group-hover:text-sky-400 group-hover:translate-x-1">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>

      <a href="https://jothon.g0v.tw/about/" target="_blank" rel="noopener noreferrer"
         class="group flex items-center gap-4 bg-white/4 border border-white/6 p-5 rounded-2xl no-underline text-inherit transition-all duration-300 hover:bg-white/8 hover:border-sky-400/20 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/20">
        <div class="w-12 h-12 flex items-center justify-center bg-sky-400/8 rounded-xl text-2xl shrink-0 transition-transform duration-300 group-hover:scale-110">
          💬
        </div>
        <div class="flex-1 text-left">
          <h3 class="text-base font-semibold text-slate-100 mb-1">聯繫我們</h3>
          <p class="text-xs text-slate-400 leading-snug">瞭解 jothon 團隊或直接與我們聯絡</p>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-slate-600 transition-all duration-300 group-hover:text-sky-400 group-hover:translate-x-1">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>

    <!-- Bottom -->
    <div class="border-t border-white/6 pt-6 text-center text-xs text-slate-600 space-y-1">
      <p>© {new Date().getFullYear()} 台灣公民科技資料庫 Civic Tech Taiwan</p>
      <p class="text-slate-700">Built with ❤️ by the community</p>
    </div>
  </div>
</footer>
