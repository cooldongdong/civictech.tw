---
// 淺色／深色手動切換。沒按過就跟系統（由 Base.astro head 裡的 inline script 決定），
// 按過才把選擇寫進 localStorage。圖示顯示「按下去會變成什麼」：淺色時是月亮、深色時是太陽。
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle flex h-10 w-10 items-center justify-center rounded-md"
  aria-label="切換淺色／深色模式"
>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<style>
  .theme-toggle {
    color: var(--ink-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .icon-sun { display: none; }
  :global(html[data-theme="dark"]) .icon-sun { display: block; }
  :global(html[data-theme="dark"]) .icon-moon { display: none; }
</style>

<script>
  const btn = document.getElementById("theme-toggle");
  const root = document.documentElement;

  function label() {
    btn?.setAttribute("aria-label", root.dataset.theme === "dark" ? "切換成淺色模式" : "切換成深色模式");
  }
  label();
  document.addEventListener("themechange", label);

  btn?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    try {
      localStorage.setItem("theme", next);
    } catch {
      /* 存不進去就只換這一頁 */
    }
    root.dataset.theme = next;
    document.dispatchEvent(new CustomEvent("themechange", { detail: next }));
  });
</script>
