# Google Sheets & Forms configuration for WishPool
PUBLIC_GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=YOUR_GID&single=true&output=csv"
PUBLIC_GOOGLE_FORM_ACTION_URL="https://docs.google.com/forms/d/e/YOUR_FORM_ID/formResponse"

# Form field entry IDs
PUBLIC_ENTRY_TITLE="entry.XXXXXXXX"
PUBLIC_ENTRY_DESCRIPTION="entry.XXXXXXXX"
PUBLIC_ENTRY_PAINPOINT="entry.XXXXXXXX"
PUBLIC_ENTRY_SUPERPOWER="entry.XXXXXXXX"
PUBLIC_ENTRY_PROGRESS="entry.XXXXXXXX"

# 設成 1 會掛上「改版預覽」橫幅、noindex 與擋收錄的 robots.txt。正式站的 build 不要帶。
PUBLIC_PREVIEW=""

# 修改建議表單（Airtable）的連結。不設時跟著 PUBLIC_PREVIEW：預覽站有、正式站沒有。
# Airtable 表單能送出之後，正式站設成 1 才會出現。
PUBLIC_SUGGEST_EDIT=""
